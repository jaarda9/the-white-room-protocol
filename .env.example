# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Local dev server port (optional, defaults to 3000)
PORT=

# MongoDB URI (Required for persistence: without it the API falls back to an in-memory store)
MONGODB_URI=
MONGODB_DB=

# Optional LLM Provider Configuration
AI_PROVIDER=gemini
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ROUTEWAI_API_KEY=
OPENAI_COMPAT_API_KEY=

# Web Push (System notifications). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach (mailto: or https:), optional
VAPID_SUBJECT=
# Shared secret for the scheduled-transmission tick (cron-job.org sends it as "Authorization: Bearer <secret>")
CRON_SECRET=
