{
  "functions": {
    "api/ai.ts": {
      "maxDuration": 120
    },
    "api/chatgpt.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

